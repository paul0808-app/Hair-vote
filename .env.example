# ---------------------------------------------------------------------
# Supabase への接続情報
#
# この2つを Vercel の環境変数に登録します（手順は README を参照）。
# SUPABASE_SERVICE_ROLE_KEY はサーバー側だけで使う秘密の鍵です。
# 絶対に人に見せず、名前の先頭に NEXT_PUBLIC_ を付けないでください
# （付けるとブラウザに公開され、誰でもデータベースを操作できてしまいます）。
# ---------------------------------------------------------------------

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ここに service_role キー（または secret キー）を貼る
